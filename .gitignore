# Data and models stay out of git (see data/README.md)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
*.joblib
*.pkl
*.parquet
*.pcap
*.pcapng
*.db
*.sqlite

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.env
